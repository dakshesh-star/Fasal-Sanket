# Optional Copernicus Data Space STAC endpoint and collection overrides
CDSE_STAC_URL=https://stac.dataspace.copernicus.eu/v1/search
CDSE_STAC_COLLECTION=sentinel-2-l2a

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5500,http://localhost:5500

# Authentication and local persistence
FASAL_JWT_SECRET=replace-with-a-long-random-secret-before-deployment
APP_ENV=development
FASAL_DATABASE_PATH=data/fasal_sanket.sqlite3
FORCE_HTTPS=false

# Production durable database and background queue. Local SQLite remains the
# default when DATABASE_URL is blank; production must use managed PostgreSQL.
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
JOB_DISPATCH_INTERVAL=10
JOB_VISIBILITY_TIMEOUT=21600
JOB_SOFT_TIMEOUT_SECONDS=14400
JOB_HARD_TIMEOUT_SECONDS=15000
JOB_STALE_AFTER_SECONDS=1800

# Public STAC scene discovery does not require credentials. These OAuth values are
# optional and are not used by the direct S3 asset processing pipeline below.
CDSE_OAUTH_CLIENT_ID=
CDSE_OAUTH_CLIENT_SECRET=

# Direct STAC asset processing uses CDSE S3 credentials (not Sentinel Hub OAuth).
# Generate a key pair in your CDSE account and keep both values in the private .env.
CDSE_S3_ENDPOINT=https://eodata.dataspace.copernicus.eu
CDSE_S3_ACCESS_KEY_ID=
CDSE_S3_SECRET_ACCESS_KEY=
